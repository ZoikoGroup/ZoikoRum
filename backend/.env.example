# Copy to backend/.env for local development. Never commit .env.
ZK_ENV=local
ZK_DATABASE_URL=postgresql+asyncpg://zoikorum:zoikorum@localhost:5434/zoikorum
ZK_JWT_SECRET=change-me-local-only-at-least-32-bytes-long
ZK_FIELD_ENCRYPTION_KEY=change-me-local-field-key
ZK_ACCESS_TOKEN_TTL_SECONDS=900
ZK_REFRESH_TOKEN_TTL_SECONDS=1209600
ZK_STEP_UP_MAX_AGE_SECONDS=300
ZK_EVENT_BUS=inprocess
ZK_PAYMENT_PROVIDER=fake
ZK_WEBHOOK_SECRET=change-me-webhook-secret
ZK_STORAGE_DIR=var/storage
# Identity checks: fake | simulated (development: pick the partner's answer on the page) | manual | persona | veriff
ZK_VERIFICATION_PROVIDER=fake
# Veriff Station > Integrations. Webhook URL to set there (decisions and events): https://<api-host>/v1/verification/webhooks/veriff
ZK_VERIFF_API_KEY=
ZK_VERIFF_SHARED_SECRET=
ZK_VERIFF_BASE_URL=https://stationapi.veriff.com
# Persona: webhook URL https://<api-host>/v1/verification/webhooks/persona
ZK_PERSONA_API_KEY=
ZK_PERSONA_TEMPLATE_ID=
ZK_PERSONA_WEBHOOK_SECRET=
# Logs: json (servers) or text (terminal); default text locally. Error reporting needs backend[monitoring].
ZK_LOG_LEVEL=INFO
ZK_LOG_FORMAT=
ZK_SENTRY_DSN=
ZK_RELEASE=dev
# Shared rate limits across API servers (docker-compose.yml runs Redis on 6380 locally)
ZK_REDIS_URL=
# Platform deadlines (days; enterprise policy profiles may override). Management to confirm.
ZK_ACCEPTANCE_WINDOW_DAYS=5
ZK_SIGNATURE_DEADLINE_DAYS=7
ZK_DISPUTE_EVIDENCE_DAYS=3
ZK_DISPUTE_DIRECT_RESOLUTION_BUSINESS_DAYS=5
ZK_DISPUTE_CHALLENGE_WINDOW_DAYS=0
