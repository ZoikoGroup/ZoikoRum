# =====================================================================================================================
# Zoikorum backend settings - LOCAL DEVELOPMENT template
# Copy to backend/.env and run. Nothing here is real: no outside service is called, nothing is charged or emailed.
# For staging/production use .env.production.example instead. Never commit .env files or real keys.
# Every setting is optional locally; the value shown is the default unless marked "local".
# =====================================================================================================================

# ---- Core ------------------------------------------------------------------------------------------------------------
ZK_ENV=local                                   # local | development | test | staging | production
ZK_RELEASE=dev                                 # version label shown with errors
ZK_FRONTEND_URL=http://localhost:5173          # used in email links
ZK_STAFF_FRONTEND_URL=http://localhost:5174    # staff web app (npm run dev:staff); links in emails to staff
ZK_WEBAUTHN_RP_ID=                             # passkeys: empty = host of ZK_FRONTEND_URL (localhost works for both apps)
ZK_PUBLIC_API_URL=                             # where identity providers post SAML sign-ins; empty = ZK_FRONTEND_URL
# PostgreSQL from docker-compose.yml (docker compose up -d)
ZK_DATABASE_URL=postgresql+asyncpg://zoikorum:zoikorum@localhost:5434/zoikorum
ZK_DB_POOL_SIZE=10
# Production: migrations as the database owner, the app as a restricted user (cli db-grants).
ZK_MIGRATION_DATABASE_URL=
ZK_DB_APP_ROLE=

# ---- Secrets (any value works locally; servers need long random ones) --------------------------------------------------
ZK_JWT_SECRET=change-me-local-only-at-least-32-bytes-long
ZK_FIELD_ENCRYPTION_KEY=change-me-local-field-key
# Production: field encryption keys wrapped by Cloud KMS (python -m zoikorum.cli new-field-key --id 2026-10).
ZK_FIELD_KMS_KEY_NAME=
ZK_FIELD_DATA_KEYS=
ZK_FIELD_ACTIVE_KEY=
ZK_WEBHOOK_SECRET=change-me-webhook-secret
# Token signing: hs256 (ZK_JWT_SECRET) | rs256 (RSA key, public half at /.well-known/jwks.json; a temporary key locally)
ZK_JWT_SIGNING=hs256
ZK_JWT_PRIVATE_KEYS=                           # JSON {"<kid>": "<PEM private key>"} (python -m zoikorum.cli new-jwt-key)
ZK_JWT_ACTIVE_KID=
ZK_JWT_PUBLIC_KEYS=                            # JSON {"<kid>": "<PEM public key>"}: retired keys still verifying
ZK_JWT_KMS_KEY_NAME=                           # Cloud KMS asymmetric signing key version instead of local keys
ZK_JWT_ACCEPT_HS256=true                       # transition: still accept tokens signed with ZK_JWT_SECRET

# ---- Sign-in ----------------------------------------------------------------------------------------------------------
ZK_ACCESS_TOKEN_TTL_SECONDS=900                # 15 minutes
ZK_REFRESH_TOKEN_TTL_SECONDS=1209600           # 14 days
ZK_STEP_UP_MAX_AGE_SECONDS=300                 # how long a fresh two-step confirmation counts for sensitive actions
# Local only: skip authenticator codes while building. The app refuses to start with this on staging/production.
ZK_DEV_SKIP_MFA=false

# ---- Email -------------------------------------------------------------------------------------------------------------
ZK_EMAIL_PROVIDER=console                      # console = print emails in the API log | smtp = really send
ZK_EMAIL_FROM=notifications@zoikorum.com
ZK_SMTP_HOST=
ZK_SMTP_PORT=587
ZK_SMTP_USERNAME=
ZK_SMTP_PASSWORD=
ZK_SMTP_STARTTLS=true

# ---- Payments and escrow ------------------------------------------------------------------------------------------------
ZK_PAYMENT_PROVIDER=fake                       # fake = test card tok_visa, no money moves | stripe
ZK_STRIPE_SECRET_KEY=
ZK_STRIPE_WEBHOOK_SECRET=
ZK_STRIPE_API_VERSION=
ZK_PAYMENT_OPERATING_COUNTRIES=[]              # JSON list, e.g. ["GB","US"]
ZK_PAYMENT_FLOW_APPROVED=false
ZK_PLATFORM_FEE_BPS=1000                       # 1000 = 10.00%
ZK_PAYOUT_SETTLEMENT_BUSINESS_DAYS=2

# ---- Identity verification ------------------------------------------------------------------------------------------------
# fake | simulated (pick the partner's answer on the page) | manual | veriff | persona
ZK_VERIFICATION_PROVIDER=simulated
ZK_VERIFF_API_KEY=
ZK_VERIFF_SHARED_SECRET=
ZK_VERIFF_BASE_URL=https://stationapi.veriff.com
ZK_PERSONA_API_KEY=
ZK_PERSONA_TEMPLATE_ID=
ZK_PERSONA_WEBHOOK_SECRET=

# ---- File storage ---------------------------------------------------------------------------------------------------------
ZK_MALWARE_SCANNER=none                        # clamav: scan every upload (docker run -p 3310:3310 clamav/clamav:1.4)
ZK_CLAMAV_HOST=localhost
ZK_CLAMAV_PORT=3310
ZK_STORAGE_PROVIDER=local                      # local folder below | database (files in PostgreSQL) | r2 | gcs | s3
ZK_STORAGE_DIR=var/storage
ZK_R2_BUCKET=                                  # r2: Cloudflare R2 bucket (free tier); token in AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY
ZK_R2_ACCOUNT_ID=
ZK_R2_ENDPOINT_URL=
ZK_GCS_BUCKET=                                 # gcs: bucket name (pip install .[gcs]; gcloud auth application-default login)
ZK_GCS_KMS_KEY_NAME=
ZK_S3_BUCKET=
ZK_AWS_REGION=us-east-1
ZK_S3_ENDPOINT_URL=                            # only for a local S3-compatible service (e.g. MinIO)
ZK_S3_KMS_KEY_ID=
ZK_S3_OBJECT_LOCK_MODE=
ZK_S3_RETENTION_DAYS=

# ---- AI (optional; without it search and matching use keyword rules) ----------------------------------------------------
ZK_AI_PROVIDER=offline                         # offline | anthropic (needs: pip install .[ai])
ZK_ANTHROPIC_API_KEY=
ZK_AI_MODEL=claude-opus-5-5
ZK_AI_DISABLED_PROMPTS=[]                      # JSON list; switch a prompt off, e.g. ["document-check"]

# ---- Operations ---------------------------------------------------------------------------------------------------------
ZK_METRICS_TOKEN=                              # GET /metrics needs "Authorization: Bearer <this>"; empty = no metrics page
ZK_TRACING_ENDPOINT=                           # OpenTelemetry collector, e.g. http://localhost:4318/v1/traces (pip install .[tracing])
ZK_TRACING_SAMPLE_RATIO=0.1
ZK_TRACING_ALWAYS_SAMPLE_PATHS=                # JSON list; empty = payments, escrow, contracts, disputes always traced
ZK_SIGN_IN_VELOCITY_PER_HOUR=10                # advisory risk signal: more sign-ins than this to one account in an hour
ZK_SIGN_IN_MAX_TRAVEL_KMH=900                  # advisory risk signal: impossible travel between two sign-ins
ZK_CACHE_ENABLED=true                          # read cache (Redis when ZK_REDIS_URL is set, else per process)
ZK_CACHE_TTL_SECONDS=300
ZK_RETENTION_RULES={}                          # JSON {"<evidence type>": {"default": days, "<country>": days}}
ZK_RETENTION_PURGE_ENABLED=false               # false: the daily retention job only reports (cli retention-report)
ZK_IDEMPOTENCY_RETENTION_DAYS=30               # daily clean-up of replayed-request records
ZK_EVENT_RETENTION_DAYS=30                     # ... and of events every consumer has handled (minimum 7)

# ---- Rate limits, logs, errors ----------------------------------------------------------------------------------------------
ZK_RATE_LIMIT_ENABLED=true
ZK_REDIS_URL=                                  # docker-compose.yml runs Redis on 6380: redis://localhost:6380/0
ZK_LOG_LEVEL=INFO
ZK_LOG_FORMAT=                                 # text locally by default | json
ZK_SENTRY_DSN=

# ---- Events and outside partners ------------------------------------------------------------------------------------------
ZK_EVENT_BUS=inprocess                         # inprocess | kafka (needs: pip install .[kafka])
ZK_KAFKA_BOOTSTRAP=localhost:9092
ZK_OUTBOX_BATCH_SIZE=100
ZK_CONSUMER_MAX_ATTEMPTS=5
ZK_WEBHOOK_TOLERANCE_SECONDS=300
ZK_PROVIDER_BREAKER_FAILURES=5
ZK_PROVIDER_BREAKER_RESET_SECONDS=30

# ---- Platform deadlines and rules (management to confirm) ----------------------------------------------------------------
ZK_SIGNATURE_DEADLINE_DAYS=7
# Days the other side has to answer a request to end an engagement by agreement.
ZK_TERMINATION_RESPONSE_DAYS=7
# Hours a professional has to answer a proposal request (reminded a day before; the buyer is told if it passes).
ZK_REQUEST_RESPONSE_HOURS=72
ZK_ACCEPTANCE_WINDOW_DAYS=5
ZK_MAX_PROFESSIONALS_PER_REQUEST=5
ZK_MEETING_BASE_URL=https://meet.jit.si/
ZK_FUNDING_REMINDER_DAYS=7
ZK_FUNDING_EXPIRY_DAYS=30
ZK_RELEASE_BLOCK_ESCALATION_DAYS=5
ZK_DISPUTE_EVIDENCE_DAYS=3
ZK_DISPUTE_DIRECT_RESOLUTION_BUSINESS_DAYS=5
# Invoice tax by buyer country (JSON; finance decides). Example: {"IN":{"label":"GST","rateBps":1800,"basis":"FEE"}}
ZK_TAX_RULES=
ZK_MESSAGING_ABUSE_TERMS=
ZK_MESSAGING_CIRCUMVENTION_TERMS=
ZK_FX_RATES=
ZK_FX_MARGIN_BPS=300
ZK_DISPUTE_CHALLENGE_WINDOW_DAYS=0
# Share (%) of partner-approved checks a compliance officer looks at again.
ZK_VERIFICATION_SECOND_LOOK_PCT=10
ZK_VERIFICATION_APPEAL_DAYS=14
# Trust & Safety: triage target (hours), appeal window (days), playbook version recorded with decisions.
ZK_ENFORCEMENT_TRIAGE_HOURS=48
ZK_ENFORCEMENT_APPEAL_DAYS=14
ZK_ENFORCEMENT_POLICY_VERSION=trust-safety-playbook@2026.1
# Staff maker-checker: hours a privileged request waits for a second person's approval before it expires.
ZK_APPROVAL_EXPIRY_HOURS=24
ZK_ERASURE_COOLING_OFF_DAYS=14
ZK_DATA_EXPORT_DAYS=7
ZK_TRUST_COMPLETION_HALF_LIFE_DAYS=365
ZK_TRUST_COMPLETION_FULL_CREDIT=10
# Closed dispute records are kept at least this many years (longer where policy or law requires)
ZK_DISPUTE_RETENTION_YEARS=7
# Sign in with Google / Microsoft (optional; register an OpenID Connect app with each, redirect URI <frontend>/sso/callback)
ZK_GOOGLE_CLIENT_ID=
ZK_GOOGLE_CLIENT_SECRET=
ZK_MICROSOFT_CLIENT_ID=
ZK_MICROSOFT_CLIENT_SECRET=
# Browser push notifications (optional): python -m zoikorum.cli new-push-keys prints a key pair
ZK_VAPID_PUBLIC_KEY=
ZK_VAPID_PRIVATE_KEY=
ZK_VAPID_SUBJECT=mailto:security@example.com
# Reports and dashboards read from this database (a read replica), if set; empty: the main database
ZK_ANALYTICS_DATABASE_URL=
