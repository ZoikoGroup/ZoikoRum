# =====================================================================================================================
# Zoikorum backend settings - STAGING / PRODUCTION template
#
# How to use:
#   1. Copy to backend/.env.production (git-ignored) for docker-compose.prod.yml, or enter each line in your host's
#      secret manager / environment settings (AWS ECS, Render, Railway ...). Never commit the filled-in file.
#   2. Replace every <...> value. Lines marked REQUIRED must be filled; OPTIONAL lines can stay blank (blank = default).
#   3. Use different secrets for staging and production.
#   4. Check it before deploying (prints only OK or what is wrong, never the values):
#        docker compose -f docker-compose.prod.yml run --rm api python -m zoikorum.cli check-config
#   The API also refuses to start with development secrets, a non-https address, or development-only switches.
#
# Comments are on their own lines on purpose: some hosts do not strip comments after a value.
# Make a long random value with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================================================================


# ---- 1. Core (REQUIRED) -----------------------------------------------------------------------------------------------
# staging or production
ZK_ENV=production
# Version label, shown with errors (docker-compose.prod.yml sets it from the build)
ZK_RELEASE=<2026.10.1>
# Public https address of the web app; used in every email link
ZK_FRONTEND_URL=https://<app.your-domain.com>
# The separate staff web app (web image built with VITE_PORTAL=staff). Links in emails to staff point here.
ZK_STAFF_FRONTEND_URL=https://<staff.your-domain.com>
# Passkeys: the shared parent domain of both apps (passkeys are tied to it). Changing it later invalidates every passkey.
ZK_WEBAUTHN_RP_ID=<your-domain.com>
# Managed PostgreSQL 16 (e.g. AWS RDS) with backups and point-in-time recovery. Format:
# postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
ZK_DATABASE_URL=postgresql+asyncpg://<user>:<password>@<db-host>:5432/<zoikorum>
# Connections per API process
ZK_DB_POOL_SIZE=10
# Production: migrations as the database owner, the app as a restricted user (cli db-grants).
ZK_MIGRATION_DATABASE_URL=
ZK_DB_APP_ROLE=


# ---- 2. Secrets (REQUIRED: long random values, 32+ characters, different per environment) ------------------------------
# Signs sign-in tokens. Changing it signs everyone out.
ZK_JWT_SECRET=<random-48-characters>
# Encrypts private fields in the database. NEVER change it after launch without a re-encryption plan: data becomes unreadable.
ZK_FIELD_ENCRYPTION_KEY=<random-48-characters>
# Production: field encryption keys wrapped by Cloud KMS (python -m zoikorum.cli new-field-key --id 2026-10).
ZK_FIELD_KMS_KEY_NAME=
ZK_FIELD_DATA_KEYS=
ZK_FIELD_ACTIVE_KEY=
# Signs Zoikorum's own outgoing webhooks to customers' systems
ZK_WEBHOOK_SECRET=<random-48-characters>
# Sign-in token signing. hs256 uses ZK_JWT_SECRET. rs256 signs with an RSA key (public keys at /.well-known/jwks.json):
# a Cloud KMS key version (ZK_JWT_KMS_KEY_NAME, recommended) or ZK_JWT_PRIVATE_KEYS {"<kid>": "<PEM>"} + ZK_JWT_ACTIVE_KID.
# Rotation: add the new key, make it active, move the old one to ZK_JWT_PUBLIC_KEYS for one refresh-token lifetime.
# Keep ZK_JWT_ACCEPT_HS256=true for one access-token lifetime after switching, then set it to false.
ZK_JWT_SIGNING=hs256
ZK_JWT_PRIVATE_KEYS=
ZK_JWT_ACTIVE_KID=
ZK_JWT_PUBLIC_KEYS=
ZK_JWT_KMS_KEY_NAME=
ZK_JWT_ACCEPT_HS256=true


# ---- 3. Sign-in -------------------------------------------------------------------------------------------------------
ZK_ACCESS_TOKEN_TTL_SECONDS=900
ZK_REFRESH_TOKEN_TTL_SECONDS=1209600
# How long a fresh two-step confirmation counts for sensitive actions (payments, releases)
ZK_STEP_UP_MAX_AGE_SECONDS=300
# Public API address where identity providers post SAML sign-ins (<this>/v1/auth/saml/acs). Empty: ZK_FRONTEND_URL.
ZK_PUBLIC_API_URL=
# Advisory sign-in risk signals (recorded, never blocking): sign-ins per hour per account; impossible-travel speed.
ZK_SIGN_IN_VELOCITY_PER_HOUR=10
ZK_SIGN_IN_MAX_TRAVEL_KMH=900
# Do NOT set ZK_DEV_SKIP_MFA here: the app refuses to start with it outside development.


# ---- 4. Email (REQUIRED for real sign-ups: confirmation and password-reset emails) ----------------------------------------
# AWS SES SMTP (or any SMTP service). Verify the sending domain and add SPF, DKIM and DMARC DNS records.
ZK_EMAIL_PROVIDER=smtp
ZK_EMAIL_FROM=notifications@<your-domain.com>
# e.g. email-smtp.eu-west-2.amazonaws.com
ZK_SMTP_HOST=<email-smtp.region.amazonaws.com>
ZK_SMTP_PORT=587
ZK_SMTP_USERNAME=<smtp-username>
ZK_SMTP_PASSWORD=<smtp-password>
ZK_SMTP_STARTTLS=true


# ---- 5. Payments and escrow (REQUIRED before taking real money) ----------------------------------------------------------
# Stripe holds buyers' funds per milestone; Zoikorum's ledger tracks them; Stripe Connect pays professionals on acceptance.
# Whether this counts as legal escrow in each country is a legal decision (see docs/LAUNCH_CHECKLIST.md).
# Until Stripe approves the funds flow, leave ZK_PAYMENT_FLOW_APPROVED=false: funding stays switched off.
ZK_PAYMENT_PROVIDER=stripe
# Stripe Dashboard > Developers > API keys (sk_test_... on staging, sk_live_... on production)
ZK_STRIPE_SECRET_KEY=<sk_live_...>
# Stripe Dashboard > Developers > Webhooks. Endpoint URL: https://<app.your-domain.com>/v1/payments/webhooks/stripe
ZK_STRIPE_WEBHOOK_SECRET=<whsec_...>
# Optional: pin the Stripe API version, e.g. 2026-08-27
ZK_STRIPE_API_VERSION=
# Countries where payments are switched on (JSON list of ISO codes)
ZK_PAYMENT_OPERATING_COUNTRIES=["GB","US"]
ZK_PAYMENT_FLOW_APPROVED=false
# Platform fee in basis points: 1000 = 10.00%
ZK_PLATFORM_FEE_BPS=1000
# Shown to professionals: expected bank arrival after a payout starts
ZK_PAYOUT_SETTLEMENT_BUSINESS_DAYS=2


# ---- 6. Identity verification (REQUIRED for Tier B/A professionals) -------------------------------------------------------
# veriff (chosen), persona, or manual (staff review documents themselves). "simulated" and "fake" are refused here.
ZK_VERIFICATION_PROVIDER=veriff
# Veriff Station > Integrations. Webhook URL to set there: https://<app.your-domain.com>/v1/verification/webhooks/veriff
ZK_VERIFF_API_KEY=<veriff-api-key>
ZK_VERIFF_SHARED_SECRET=<veriff-shared-secret>
ZK_VERIFF_BASE_URL=https://stationapi.veriff.com
# Only if using Persona instead (webhook: https://<app.your-domain.com>/v1/verification/webhooks/persona)
ZK_PERSONA_API_KEY=
ZK_PERSONA_TEMPLATE_ID=
ZK_PERSONA_WEBHOOK_SECRET=


# ---- 7. File storage (REQUIRED: uploads, contracts, evidence) ---------------------------------------------------------------
# Google Cloud Storage bucket: object versioning ON, public access prevention ENFORCED, uniform bucket-level access.
# The app signs in as the service account it runs as (Cloud Run / GKE): no key file. Grant that service account the
# permissions in backend/docs/DEPLOYMENT.md ("File storage on Google Cloud"). Retention: set a retention policy on the
# bucket if legal requires evidence to be kept for a fixed period.
# Every upload is scanned by ClamAV before it is stored (the clamav service in docker-compose.prod.yml).
ZK_MALWARE_SCANNER=clamav
ZK_CLAMAV_HOST=clamav
ZK_CLAMAV_PORT=3310
ZK_STORAGE_PROVIDER=database
# database = uploaded files are kept in PostgreSQL (platform.stored_files), backed up and restored with the data.
# Alternative free cloud option: Cloudflare R2 (ZK_STORAGE_PROVIDER=r2, 10 GB free, private bucket). Credentials: the
# R2 API token as AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. No versioning; files are never overwritten.
ZK_R2_BUCKET=
ZK_R2_ACCOUNT_ID=
ZK_R2_ENDPOINT_URL=

# Alternative: Google Cloud Storage (ZK_STORAGE_PROVIDER=gcs). Leave empty when using R2.
ZK_GCS_BUCKET=
# Optional: customer-managed encryption key (default: Google-managed encryption)
# projects/<project>/locations/<region>/keyRings/<ring>/cryptoKeys/<key>
ZK_GCS_KMS_KEY_NAME=

# Alternative: Amazon S3 (ZK_STORAGE_PROVIDER=s3). Leave these empty when using Google Cloud Storage.
ZK_S3_BUCKET=
ZK_AWS_REGION=
ZK_S3_KMS_KEY_ID=
ZK_S3_OBJECT_LOCK_MODE=
ZK_S3_RETENTION_DAYS=
ZK_S3_ENDPOINT_URL=


# ---- 8. Rate limits (RECOMMENDED with more than one server) ----------------------------------------------------------------
ZK_RATE_LIMIT_ENABLED=true
# Managed Redis (e.g. AWS ElastiCache). docker-compose.prod.yml provides redis://redis:6379/0 by default.
ZK_REDIS_URL=redis://<redis-host>:6379/0
# Read cache for taxonomy, trust tiers, policy profiles and search facets (Redis above; falls back to the database).
ZK_CACHE_ENABLED=true
ZK_CACHE_TTL_SECONDS=300


# ---- 9. Logs and error reporting --------------------------------------------------------------------------------------------
ZK_LOG_LEVEL=INFO
# json for log collectors (default on servers)
ZK_LOG_FORMAT=json
# OPTIONAL: Sentry project DSN for error alerts. Personal data is never sent.
ZK_SENTRY_DSN=


# ---- 10. AI (OPTIONAL: without it, "describe what you need" and specialization matching use keyword rules) -----------------
# offline or anthropic. anthropic needs the [ai] extra in the image.
ZK_AI_PROVIDER=offline
ZK_ANTHROPIC_API_KEY=
ZK_AI_MODEL=claude-opus-5-5
# Switch a built-in prompt off without a release (its feature uses keyword rules), e.g. ["document-check"].
ZK_AI_DISABLED_PROMPTS=[]

# ---- 11. Operations ------------------------------------------------------------------------------------------------------
# Prometheus scrapes GET /metrics with "Authorization: Bearer <this>". Empty: no metrics page (it answers 404).
ZK_METRICS_TOKEN=
# Traces (OpenTelemetry collector, OTLP over HTTP), e.g. http://otel-collector:4318/v1/traces. Empty: no traces.
ZK_TRACING_ENDPOINT=
ZK_TRACING_SAMPLE_RATIO=0.1
# Paths always traced in full (JSON list). Empty: payments, escrow, contracts, milestones, disputes.
ZK_TRACING_ALWAYS_SAMPLE_PATHS=
# Evidence retention per type and country, in days (JSON), e.g. {"data_export": {"default": 30}}. Types not listed are
# kept. The daily job only reports (python -m zoikorum.cli retention-report) until the purge is switched on; files under
# legal hold are never purged.
ZK_RETENTION_RULES={}
ZK_RETENTION_PURGE_ENABLED=false
# Daily clean-up of bookkeeping rows. Business records, audit and the money ledger are never touched.
ZK_IDEMPOTENCY_RETENTION_DAYS=30
ZK_EVENT_RETENTION_DAYS=30


# ---- 12. Events and partner resilience (defaults are fine) -------------------------------------------------------------------
ZK_EVENT_BUS=inprocess
ZK_OUTBOX_BATCH_SIZE=100
ZK_CONSUMER_MAX_ATTEMPTS=5
# Incoming partner webhooks older than this are refused (replay protection)
ZK_WEBHOOK_TOLERANCE_SECONDS=300
ZK_PROVIDER_BREAKER_FAILURES=5
ZK_PROVIDER_BREAKER_RESET_SECONDS=30


# ---- 13. Platform deadlines and rules (management to confirm each value before launch) -----------------------------------------
# Days to sign a contract before it escalates
ZK_SIGNATURE_DEADLINE_DAYS=7
# Days the other side has to answer a request to end an engagement by agreement.
ZK_TERMINATION_RESPONSE_DAYS=7
# Hours a professional has to answer a proposal request (reminded a day before; the buyer is told if it passes).
ZK_REQUEST_RESPONSE_HOURS=72
# Buyer's review window after work is submitted
ZK_ACCEPTANCE_WINDOW_DAYS=5
# How many professionals one request can go to (1-10)
ZK_MAX_PROFESSIONALS_PER_REQUEST=5
# Video rooms for meetings when people do not paste their own link (a self-hosted Jitsi works too); empty: always paste
ZK_MEETING_BASE_URL=https://meet.jit.si/
# Remind the buyer this many days before an unfunded milestone is due
ZK_FUNDING_REMINDER_DAYS=7
# A signed engagement never funded this many days after activation expires (allocations EXPIRED, engagement ended)
ZK_FUNDING_EXPIRY_DAYS=30
# Accepted work whose payment release was not approved: remind approvers, admins and the professional every this many days
ZK_RELEASE_BLOCK_ESCALATION_DAYS=5
ZK_DISPUTE_EVIDENCE_DAYS=3
ZK_DISPUTE_DIRECT_RESOLUTION_BUSINESS_DAYS=5
# Invoice tax by buyer country (JSON; finance decides). Example: {"IN":{"label":"GST","rateBps":1800,"basis":"FEE"}}
ZK_TAX_RULES=
ZK_MESSAGING_ABUSE_TERMS=
ZK_MESSAGING_CIRCUMVENTION_TERMS=
# Spend limits in another currency: units per 1 USD set by Finance, e.g. {"USD": 1, "EUR": 0.92, "GBP": 0.79}. Empty: no conversion
ZK_FX_RATES=
# Safety margin added to converted amounts (basis points; 300 = 3%)
ZK_FX_MARGIN_BPS=300
# Days after acceptance in which accepted work can still be disputed (0 = not allowed)
ZK_DISPUTE_CHALLENGE_WINDOW_DAYS=0
# Share (%) of partner-approved checks a compliance officer looks at again.
ZK_VERIFICATION_SECOND_LOOK_PCT=10
ZK_VERIFICATION_APPEAL_DAYS=14
# Trust & Safety: triage target (hours), appeal window (days), playbook version recorded with decisions.
ZK_ENFORCEMENT_TRIAGE_HOURS=48
ZK_ENFORCEMENT_APPEAL_DAYS=14
ZK_ENFORCEMENT_POLICY_VERSION=trust-safety-playbook@2026.1
# Staff maker-checker: hours a privileged request waits for a second person's approval before it expires.
ZK_APPROVAL_EXPIRY_HOURS=24
# Account deletion can be cancelled for this many days
ZK_ERASURE_COOLING_OFF_DAYS=14
# How long a personal-data export can be downloaded
ZK_DATA_EXPORT_DAYS=7
ZK_TRUST_COMPLETION_HALF_LIFE_DAYS=365
ZK_TRUST_COMPLETION_FULL_CREDIT=10
# Closed dispute records are kept at least this many years (longer where policy or law requires)
ZK_DISPUTE_RETENTION_YEARS=7
# Sign in with Google / Microsoft (optional; register an OpenID Connect app with each, redirect URI <frontend>/sso/callback)
ZK_GOOGLE_CLIENT_ID=
ZK_GOOGLE_CLIENT_SECRET=
ZK_MICROSOFT_CLIENT_ID=
ZK_MICROSOFT_CLIENT_SECRET=
# Browser push notifications (optional): python -m zoikorum.cli new-push-keys prints a key pair
ZK_VAPID_PUBLIC_KEY=
ZK_VAPID_PRIVATE_KEY=
ZK_VAPID_SUBJECT=mailto:security@example.com
# Reports and dashboards read from this database (a read replica), if set; empty: the main database
ZK_ANALYTICS_DATABASE_URL=
